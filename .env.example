# ─────────────────────────────────────────────────────────────
# Blog da Akaki — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com as chaves reais.
# O `.env` está no .gitignore e NUNCA deve ser versionado.
# Em produção, estas variáveis vão no painel da Vercel
# (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Painel do Supabase → Project Settings → Data API
# Ex.: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Chave PÚBLICA (anon/publishable). Pode aparecer no navegador —
# quem protege os dados é o RLS do banco, não o segredo desta chave.
SUPABASE_ANON_KEY=

# Chave SECRETA (service_role). Ignora TODAS as regras de segurança
# do banco. Só é usada no servidor, em operações de administrador.
# Se vazar, qualquer pessoa lê e escreve tudo. Nunca commitar,
# nunca importar em código que roda no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado entre o Supabase e o site: o banco chama
# /api/revalidate ao publicar um post, e o site só aceita a chamada
# se este segredo bater. Gere com: openssl rand -hex 32
REVALIDATE_SECRET=

# Token da Vercel para limpar o cache de uma página sob demanda
# (faz o post publicado aparecer em segundos em vez de minutos).
# Gere com: openssl rand -hex 16
VERCEL_ISR_BYPASS_TOKEN=
