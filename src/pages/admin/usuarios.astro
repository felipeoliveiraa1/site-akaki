---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { ehAdmin, clienteAdministrativo, type Perfil } from '../../lib/supabase';

const perfil = Astro.locals.perfil as Perfil;
const supabase = Astro.locals.supabase!;

// Dupla checagem: a tela some do menu para quem não é admin, mas esconder
// botão não é autorização. Aqui é bloqueio de verdade — e o banco ainda
// recusaria por conta própria.
if (!ehAdmin(perfil.papel)) {
  return new Response('Apenas administradores acessam a gestão de usuários.', { status: 403 });
}

let erro = '';
let aviso = '';
let emailNovo = '';

if (Astro.request.method === 'POST') {
  const d = await Astro.request.formData();
  const acao = String(d.get('acao') ?? '');
  const admin = clienteAdministrativo();

  if (!admin) {
    erro = 'Falta a chave administrativa do banco (SUPABASE_SERVICE_ROLE_KEY) nas variáveis de ambiente.';
  } else if (acao === 'convidar') {
    emailNovo = String(d.get('email') ?? '').trim();
    const nome = String(d.get('nome') ?? '').trim();
    const papel = String(d.get('papel') ?? 'autor');

    if (!emailNovo || !nome) erro = 'Informe nome e e-mail.';
    else if (!['admin', 'editor', 'autor'].includes(papel)) erro = 'Papel inválido.';
    else {
      // O papel é definido DEPOIS, numa escrita separada. Nunca através dos
      // metadados do convite: metadados podem ser alterados pelo próprio
      // usuário, o que viraria uma porta para se autopromover a admin.
      const { data, error } = await admin.auth.admin.inviteUserByEmail(emailNovo, { data: { nome } });
      if (error) {
        erro = error.message.includes('already') ? 'Este e-mail já tem conta.' : error.message;
      } else if (data.user) {
        await admin.from('perfis').update({ papel }).eq('id', data.user.id);
        return Astro.redirect('/admin/usuarios?ok=convidado', 303);
      }
    }
  } else if (acao === 'papel' || acao === 'ativo') {
    const alvo = String(d.get('id') ?? '');
    if (alvo === perfil.id) {
      erro = 'Você não pode alterar o próprio acesso.';
    } else {
      const campos = acao === 'papel'
        ? { papel: String(d.get('papel') ?? 'autor') }
        : { ativo: d.get('valor') === '1' };
      // Os gatilhos do banco ainda barram rebaixar o último admin.
      const { error } = await supabase.from('perfis').update(campos).eq('id', alvo);
      if (error) erro = error.message;
      else return Astro.redirect('/admin/usuarios?ok=alterado', 303);
    }
  }
  if (erro) Astro.response.status = 422;
}

const ok = Astro.url.searchParams.get('ok');
if (ok === 'convidado') aviso = 'Convite enviado. A pessoa recebe um e-mail para definir a senha.';
if (ok === 'alterado') aviso = 'Acesso atualizado.';

const { data: pessoas } = await supabase
  .from('perfis')
  .select('id, nome, slug, papel, ativo, cargo, cro, cro_uf')
  .order('nome');

const PAPEL = { admin: 'Administrador', editor: 'Editor', autor: 'Autor' } as const;
const DESCR = {
  admin: 'Tudo, inclusive criar e remover usuários.',
  editor: 'Cria, edita e publica qualquer post.',
  autor: 'Cria e edita os próprios posts; não publica.',
} as const;
---
<AdminLayout titulo="Usuários" perfil={perfil}>
  <div class="ad-cab">
    <div>
      <h1 class="ad-cab__t">Usuários</h1>
      <p class="ad-cab__d">Quem tem acesso ao painel e o que cada pessoa pode fazer.</p>
    </div>
  </div>

  {aviso && <div class="ad-aviso ad-aviso--ok" role="status">{aviso}</div>}
  {erro && <div class="ad-aviso ad-aviso--erro" role="alert">{erro}</div>}

  <div class="ad-card">
    <p class="ad-card__t">Convidar alguém</p>
    <form method="POST" class="us-conv">
      <input type="hidden" name="acao" value="convidar" />
      <div class="ad-campo">
        <label class="ad-rot" for="nome">Nome</label>
        <input class="ad-in" id="nome" name="nome" required />
      </div>
      <div class="ad-campo" style="margin-top:0">
        <label class="ad-rot" for="email">E-mail</label>
        <input class="ad-in" id="email" name="email" type="email" value={emailNovo}
               inputmode="email" required />
      </div>
      <div class="ad-campo" style="margin-top:0">
        <label class="ad-rot" for="papel">Nível de acesso</label>
        <select class="ad-sel" id="papel" name="papel">
          <option value="autor">Autor</option>
          <option value="editor">Editor</option>
          <option value="admin">Administrador</option>
        </select>
      </div>
      <button class="ad-btn ad-btn--p" type="submit">Enviar convite</button>
    </form>
    <p class="ad-dica" style="margin-top:12px">
      A pessoa recebe um e-mail e define a própria senha — a clínica nunca precisa criar nem guardar senhas.
    </p>
  </div>

  <div class="us-legenda">
    {(['admin', 'editor', 'autor'] as const).map((p) => (
      <div><strong>{PAPEL[p]}</strong><span>{DESCR[p]}</span></div>
    ))}
  </div>

  <ul class="ad-lista" style="margin-top:16px">
    {(pessoas ?? []).map((u: any) => (
      <li class="ad-linha" style="grid-template-columns:minmax(0,1fr) auto auto">
        <div>
          <p class="ad-linha__t" style="font-size:16px">
            {u.nome}
            {u.id === perfil.id && <span class="ad-marca ad-marca--revisao" style="margin-left:8px">você</span>}
            {!u.ativo && <span class="ad-marca ad-marca--rascunho" style="margin-left:8px">desativado</span>}
          </p>
          <p class="ad-linha__meta">
            {[u.cargo, u.cro ? `CRO-${u.cro_uf ?? ''} ${u.cro}` : null].filter(Boolean).join(' · ') || '—'}
          </p>
        </div>

        <form method="POST">
          <input type="hidden" name="acao" value="papel" />
          <input type="hidden" name="id" value={u.id} />
          <select class="ad-sel" name="papel" onchange="this.form.requestSubmit()"
                  disabled={u.id === perfil.id} aria-label={`Nível de acesso de ${u.nome}`}
                  style="min-width:160px">
            {(['autor', 'editor', 'admin'] as const).map((p) => (
              <option value={p} selected={u.papel === p}>{PAPEL[p]}</option>
            ))}
          </select>
          <noscript><button class="ad-btn ad-btn--f" type="submit">Aplicar</button></noscript>
        </form>

        <form method="POST">
          <input type="hidden" name="acao" value="ativo" />
          <input type="hidden" name="id" value={u.id} />
          <input type="hidden" name="valor" value={u.ativo ? '0' : '1'} />
          <button class={`ad-btn ${u.ativo ? 'ad-btn--per' : 'ad-btn--f'}`} type="submit"
                  disabled={u.id === perfil.id}>
            {u.ativo ? 'Desativar' : 'Reativar'}
          </button>
        </form>
      </li>
    ))}
  </ul>
</AdminLayout>

<style is:global>
  .us-conv { display: grid; grid-template-columns: 1.2fr 1.4fr 1fr auto; gap: 12px; align-items: end; }
  .us-conv .ad-btn { min-height: 46px; }
  .us-legenda {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px;
  }
  .us-legenda div {
    background: #fff; border: 1px solid rgba(24, 39, 60, 0.1); border-radius: 12px; padding: 14px 16px;
  }
  .us-legenda strong {
    display: block; font-family: var(--sans); font-size: 10.5px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--gold-dark); margin-bottom: 5px;
  }
  .us-legenda span { font-size: 13px; color: var(--navy-soft); line-height: 1.5; }
  @media (max-width: 980px) {
    .us-conv { grid-template-columns: 1fr; }
    .us-legenda { grid-template-columns: 1fr; }
  }
</style>
