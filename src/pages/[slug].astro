<script>
  // Depoimentos em vídeo — play sob demanda + carrossel (setas no desktop)
  document.querySelectorAll('.vdepo__card').forEach((card) => {
    const video = card.querySelector('.vdepo__video');
    const btn = card.querySelector('.vdepo__play');
    if (!video || !btn) return;
    btn.addEventListener('click', () => {
      document.querySelectorAll('.vdepo__card.is-playing').forEach((other) => {
        if (other !== card) {
          other.classList.remove('is-playing');
          const ov = other.querySelector('.vdepo__video');
          if (ov) { (ov as HTMLVideoElement).pause(); ov.removeAttribute('controls'); }
        }
      });
      card.classList.add('is-playing');
      (video as HTMLVideoElement).setAttribute('controls', '');
      (video as HTMLVideoElement).play();
    });
  });

  const vtrack = document.querySelector('[data-vdepo-track]');
  const vprev = document.querySelector('[data-vdepo-prev]');
  const vnext = document.querySelector('[data-vdepo-next]');
  if (vtrack && vprev && vnext) {
    const vstep = () => {
      const card = vtrack.querySelector('.vdepo__card');
      const gap = parseFloat(getComputedStyle(vtrack).gap) || 20;
      const w = card ? card.getBoundingClientRect().width + gap : 300;
      return Math.max(w, vtrack.clientWidth * 0.85);
    };
    vprev.addEventListener('click', () => vtrack.scrollBy({ left: -vstep(), behavior: 'smooth' }));
    vnext.addEventListener('click', () => vtrack.scrollBy({ left: vstep(), behavior: 'smooth' }));
    const vupdate = () => {
      const max = vtrack.scrollWidth - vtrack.clientWidth - 2;
      vprev.classList.toggle('is-off', vtrack.scrollLeft <= 2);
      vnext.classList.toggle('is-off', vtrack.scrollLeft >= max);
    };
    vtrack.addEventListener('scroll', vupdate, { passive: true });
    window.addEventListener('resize', vupdate);
    vupdate();
  }
</script>
