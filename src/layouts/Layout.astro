---
import '../styles/fonts.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/roboto/latin-300.css';
import '@fontsource/roboto/latin-400.css';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';

const {
  title = 'Akaki Odontologia · Clínica pioneira em odontofobia · Jardim Paulista, SP',
  description = 'Tratamento odontológico com sedação consciente — em menos tempo e sem medo. Day Clinic, implantes, ortodontia e estética no Jardim Paulista, São Paulo.',
} = Astro.props;
const ogImage = new URL('/assets/film-poster.webp', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Akaki Odontologia',
  image: ogImage,
  url: Astro.site ? Astro.site.href : 'https://www.akaki.odo.br',
  telephone: '+5511947024607',
  email: 'contato@akaki.odo.br',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Estados Unidos, 205',
    addressLocality: 'São Paulo',
    addressRegion: 'SP',
    postalCode: '01427-002',
    addressCountry: 'BR',
  },
  areaServed: 'São Paulo',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '214' },
  sameAs: [
    'https://www.instagram.com/akakiodontologia/',
    'https://www.youtube.com/channel/UCyGQUid86fGgsJoGISGSuGQ',
  ],
};
---

