    <style>
      .wlead { position: fixed; inset: 0; z-index: 2000; display: grid; place-items: center; padding: 20px; opacity: 0; transition: opacity 260ms var(--silk); }
      .wlead[hidden] { display: none; }
      .wlead.is-open { opacity: 1; }
      .wlead__backdrop { position: absolute; inset: 0; background: rgba(11,14,19,0.62); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
      .wlead__card {
        position: relative; z-index: 1; width: 100%; max-width: 400px;
        background: var(--cream); border-radius: 24px; padding: 40px 32px 28px; text-align: center;
        box-shadow: 0 40px 90px -30px rgba(11,14,19,0.6); border: 1px solid rgba(211,164,108,0.28);
        transform: translateY(14px) scale(0.98); transition: transform 320ms var(--silk);
      }
      .wlead.is-open .wlead__card { transform: none; }
      .wlead__x {
        position: absolute; top: 14px; right: 14px; width: 34px; height: 34px; border: 0; cursor: pointer;
        border-radius: 50%; display: grid; place-items: center; color: var(--navy);
        background: rgba(24,39,60,0.06); transition: background 200ms var(--silk);
      }
      .wlead__x:hover { background: rgba(24,39,60,0.12); }
      .wlead__x svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
      .wlead__ic { display: inline-grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: #25D366; color: #fff; box-shadow: 0 14px 32px -8px rgba(37,211,102,0.6); margin-bottom: 18px; }
      .wlead__ic svg { width: 32px; height: 32px; fill: currentColor; }
      .wlead__title { font-family: var(--serif); font-weight: 400; font-variation-settings: 'opsz' 144; font-size: clamp(22px, 4vw, 27px); color: var(--navy); letter-spacing: -0.01em; }
      .wlead__sub { font-family: var(--body); font-size: 14px; line-height: 1.5; color: rgba(24,39,60,0.7); max-width: 30ch; margin: 8px auto 22px; }
      .wlead__form { display: flex; flex-direction: column; gap: 12px; }
      .wlead__in {
        width: 100%; font-family: var(--sans); font-size: 15px; color: var(--navy);
        background: #fff; border: 1px solid rgba(24,39,60,0.16); border-radius: 13px; padding: 14px 16px;
        transition: border-color 200ms var(--silk), box-shadow 200ms var(--silk);
      }
      .wlead__in::placeholder { color: rgba(24,39,60,0.4); }
      .wlead__in:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(211,164,108,0.18); }
      .wlead__in.is-err { border-color: #d9534f; box-shadow: 0 0 0 3px rgba(217,83,79,0.14); }
      .wlead__go {
        margin-top: 4px; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        font-family: var(--sans); font-weight: 600; font-size: 15px; color: #fff; cursor: pointer;
        background: linear-gradient(135deg, #2AC96A, #1EA855); border: 0; border-radius: 13px; padding: 15px 20px;
        box-shadow: 0 14px 34px -12px rgba(37,211,102,0.7); transition: transform 200ms var(--silk), box-shadow 200ms var(--silk);
      }
      .wlead__go:hover { transform: translateY(-1px); box-shadow: 0 18px 42px -12px rgba(37,211,102,0.85); }
      .wlead__go svg { width: 20px; height: 20px; fill: currentColor; }
      .wlead__note { font-family: var(--body); font-size: 11.5px; color: rgba(24,39,60,0.5); margin-top: 6px; }
      @media (max-width: 480px) { .wlead__card { padding: 34px 22px 24px; } }
      @media (prefers-reduced-motion: reduce) { .wlead, .wlead__card { transition: none; } }
    </style>

    <script is:inline>
      (function(){
        var WPP = '5511947024607';
        var BASE = 'Olá, gostaria de agendar uma consulta na Akaki.';
        var MAKE_WEBHOOK = 'https://claude.rizeperformance.com.br/webhook/gclid-lp';
        var SHEETS_WEBHOOK = 'https://script.google.com/macros/s/AKfycbyLlENWTXZLWtIlyQ6x5FgyIJP8mE0EpuKc08rJw2wu1_jLopM3tYPYkh9r-GXGaZCw2Q/exec';
        var modal = document.getElementById('wa-modal');
        var form = document.getElementById('wa-form');
        if (!modal || !form) return;
        // Onde existe o modal completo (#lp-modal, nas LPs), este modal simples (.wlead) atende SÓ o botão
        // flutuante (.wfab). Na home (sem #lp-modal) ele atende todos os CTAs.
        var hasFullModal = !!document.getElementById('lp-modal');
        var nomeEl = document.getElementById('wa-nome');
        var telEl = document.getElementById('wa-tel');
        var lastContent = '';
        var opener = null;

        function getCookie(n){ var m = document.cookie.match(new RegExp('(^| )' + n + '=([^;]+)')); return m ? decodeURIComponent(m[2]) : ''; }
        function lsGet(n){ try { return localStorage.getItem(n) || ''; } catch (e) { return ''; } }
        function val(k){ var u = ''; try { u = new URLSearchParams(location.search).get(k) || ''; } catch (e) {} return u || getCookie(k) || lsGet(k) || ''; }

        function openModal(content){
          lastContent = content || '';
          modal.hidden = false;
          document.body.style.overflow = 'hidden';
          requestAnimationFrame(function(){ modal.classList.add('is-open'); });
          setTimeout(function(){ nomeEl && nomeEl.focus(); }, 90);
        }
        function closeModal(){
          modal.classList.remove('is-open');
          document.body.style.overflow = '';
          setTimeout(function(){ modal.hidden = true; }, 280);
          if (opener && opener.focus) { try { opener.focus(); } catch (e) {} }
        }

        // Botão flutuante (.wfab) sempre abre este modal simples; onde há modal completo, os demais CTAs ficam com ele
        document.addEventListener('click', function(e){
          var el = e.target && e.target.closest ? e.target.closest('[data-wpp],[data-lp-open]') : null;
          if (!el) return;
          if (hasFullModal && !el.classList.contains('wfab')) return;
          e.preventDefault();
          opener = el;
          openModal(el.getAttribute('data-wpp') || el.getAttribute('data-lp-open') || '');
        });

        modal.querySelectorAll('[data-wa-close]').forEach(function(b){ b.addEventListener('click', closeModal); });
        document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !modal.hidden) closeModal(); });

        // Máscara BR simples (00) 00000-0000
        if (telEl) telEl.addEventListener('input', function(){
          var d = telEl.value.replace(/\D/g, '');
          if (d.length > 11 && d.slice(0,2) === '55') d = d.slice(2); // remove código do país (55) que o autofill coloca na frente
          d = d.slice(0, 11);
          var out = d;
          if (d.length > 7) out = '(' + d.slice(0,2) + ') ' + d.slice(2,7) + '-' + d.slice(7);
          else if (d.length > 2) out = '(' + d.slice(0,2) + ') ' + d.slice(2);
          else if (d.length > 0) out = '(' + d;
          telEl.value = out; telEl.classList.remove('is-err');
        });
        if (nomeEl) nomeEl.addEventListener('input', function(){ nomeEl.classList.remove('is-err'); });

        function buildMsg(nome, tel){
          var s = val('utm_source'), m = val('utm_medium'), c = val('utm_campaign'), t = val('utm_term'),
              ct = val('utm_content'), g = val('gclid');
          var partes = ['whatsapp'];
          if (s) partes.push('Fonte: ' + s);
          if (m) partes.push('Meio: ' + m);
          if (c) partes.push('Campanha: ' + c);
          if (t) partes.push('Termo: ' + t);
          if (ct) partes.push('Anúncio: ' + ct);
          if (g) partes.push('Google Ads: sim');
          return BASE + ' [' + partes.join(' | ') + ']';
        }

        form.addEventListener('submit', function(e){
          e.preventDefault();
          var nome = (nomeEl.value || '').trim();
          var tel = (telEl.value || '').trim();
          var telDigits = tel.replace(/\D/g, '');
          if (telDigits.length > 11 && telDigits.slice(0,2) === '55') telDigits = telDigits.slice(2);
          if (!nome) { nomeEl.classList.add('is-err'); nomeEl.focus(); return; }
          if (telDigits.length < 10) { telEl.classList.add('is-err'); telEl.focus(); return; }

          var g = val('gclid');
          // Webhook Make (mesma lógica do site atual): dispara com gclid + telefone
          if (g && telDigits) {
            try { fetch(MAKE_WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ gclid: g, telefone: telDigits, utm_source: val('utm_source'), utm_medium: val('utm_medium'), utm_campaign: val('utm_campaign') }), keepalive: true }); } catch (err) {}
          }
          // Planilha de leads (Google Sheets) — grava TODO envio, com ou sem gclid, pra não perder nenhum lead.
          // Content-Type text/plain evita o preflight CORS (Apps Script não responde OPTIONS); o Google lê o corpo como JSON normalmente.
          try {
            var lpEl = document.querySelector('.lp');
            var servico = (lpEl && lpEl.getAttribute('data-service')) || 'Home';
            fetch(SHEETS_WEBHOOK, {
              method: 'POST',
              headers: { 'Content-Type': 'text/plain;charset=utf-8' },
              body: JSON.stringify({ nome: nome, telefone: telDigits, servico: servico, qualificacao: '', utm_source: val('utm_source'), utm_medium: val('utm_medium'), utm_campaign: val('utm_campaign'), utm_content: val('utm_content'), gclid: g }),
            });
          } catch (err) {}
          // Evento p/ GTM
          try { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'whatsapp_lead', lead_nome: nome, lead_telefone: telDigits, cta: lastContent }); } catch (err) {}

          window.open('https://api.whatsapp.com/send?phone=' + WPP + '&text=' + encodeURIComponent(buildMsg(nome, tel)), '_blank');
          closeModal();
        });
      })();
    </script>
  </body>
</html>
